# All variables are optional. Without them the quiz runs in classic (non-AI) mode.

# Anthropic API key used for the AI-powered quiz.
ANTHROPIC_API_KEY=
# Model for the quiz: claude-haiku-5-5 (default) or claude-opus-5-5.
QUIZ_MODEL=
# Max AI tokens spent across all players per day (default 200000).
AI_DAILY_TOKEN_BUDGET=
# Max AI quiz games per IP per day (default 3).
AI_GAMES_PER_IP_PER_DAY=
# Upstash Redis REST URL used for budget and rate-limit counters.
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token.
UPSTASH_REDIS_REST_TOKEN=
# Random salt used to hash IPs before they are stored.
IP_HASH_SALT=
# HP-API base URL (default https://hp-api.onrender.com). E2E points it at an unreachable host.
HP_API_BASE_URL=
